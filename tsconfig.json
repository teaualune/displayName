{
  "compilerOptions": {
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["es6"],
    "noEmit": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext"
  },
  "include": ["displayName.ts"]
}
